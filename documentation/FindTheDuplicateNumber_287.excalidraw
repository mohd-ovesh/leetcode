      "updated": 1785138058571,
      "link": null,
      "locked": false,
      "text": " The problem is simple we are given an array of length n+1 that has numbers ranging from [1, n] as its values\nwe are required to find the repeating value in the array that might repeat 1 or more times.",
      "fontSize": 322,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " The problem is simple we are given an array of length n+1 that has numbers ranging from [1, n] as its values\nwe are required to find the repeating value in the array that might repeat 1 or more times.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5ixBF_uNIImPoh_UaovFF",
      "type": "text",
      "x": 3678.5391924118157,
      "y": -6595.34141267369,
      "width": 53540.58203125,
      "height": 1207.5,
      "angle": 0,
      "strokeColor": "#099268",
      "backgroundColor": "transparent",
