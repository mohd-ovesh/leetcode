      "roundness": null,
      "seed": 442502999,
      "version": 831,
      "versionNonce": 1359958295,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785138433333,
      "link": null,
      "locked": false,
      "text": "Sum, min max nothing works because the solution is quite novel actually we just have to notice that when ever we ae given an array where we have the values in it as s valid index we can convert it to a linked list or graph problem\nby traversing over the values at indexes to hop around and then if at two indexes we get the same value then that causes loop and by using tortoise and hare combined with the next step of resetting the slow pointer to the beginning and moving the fast and slow pointer one step forward at a time we can also find the entry of the loop\nand in this question the number at the loop entry is the same repeating indeex or value so our goat is made easier with this optimized approach hurray!",
      "fontSize": 322,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sum, min max nothing works because the solution is quite novel actually we just have to notice that when ever we ae given an array where we have the values in it as s valid index we can convert it to a linked list or graph problem\nby traversing over the values at indexes to hop around and then if at two indexes we get the same value then that causes loop and by using tortoise and hare combined with the next step of resetting the slow pointer to the beginning and moving the fast and slow pointer one step forward at a time we can also find the entry of the loop\nand in this question the number at the loop entry is the same repeating indeex or value so our goat is made easier with this optimized approach hurray!",
      "autoResize": true,
      "lineHeight": 1.25
    }
